{
  // 公开仓库版本：签名配置置空。签名材料（.p12 / .cer / .p7b）与密码不入库，
  // 本机构建时在 DevEco「项目结构 → 签名配置」里配置 release，由 IDE 写入本机加密串；
  // 提交前把本文件还原成这一版（字段结构见 build-profile.signing.example.json5）。
  "app": {
    "signingConfigs": [
      {
        "name": "release",
        "type": "HarmonyOS",
        "material": {
          "certpath": "",
          "keyAlias": "",
          "keyPassword": "",
          "profile": "",
          "signAlg": "SHA256withECDSA",
          "storeFile": "",
          "storePassword": ""
        }
      }
    ],
    "products": [
      {
        "name": "default",
        // 真机回归用调试签名（release 证书签名包仅限市场渠道安装，hdc 直装被拒
        // 9568322）；出上架 .app 时切回 "release"
        "signingConfig": "release",
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
